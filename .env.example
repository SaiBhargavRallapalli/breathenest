# ==============================================================
# BreatheNest — server-side configuration template
# Copy to `.env` and fill in. `.env` is git-ignored.
# ==============================================================

# --- Google Gemini (optional) --------------------------------
# BreatheNest runs WITHOUT a key too: a deterministic local
# planner takes over so the app never hard-fails.
# The key is read server-side only and is never exposed to the
# browser bundle (no VITE_ prefix, no client import).
GEMINI_API_KEY=

# --- Groq (optional, alternative GenAI backend) ----------
# Same guarantee as Gemini: without a key the deterministic local
# planner serves every plan. Server-side only, never in the bundle.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Which backend the gateway may reach for:
#   auto   — Gemini if keyed, else Groq if keyed, else local (default)
#   gemini — Gemini only    groq — Groq only    local — never call out
GENAI_PROVIDER=auto

# --- Server ---------------------------------------------------
PORT=3001
NODE_ENV=development

# --- Upstream air-quality data (Open-Meteo, key-free) ---------
# Optional overrides; sensible public defaults are baked in.
AIR_QUALITY_BASE_URL=https://air-quality-api.open-meteo.com/v1
GEOCODING_BASE_URL=https://geocoding-api.open-meteo.com/v1
# Seconds each upstream response is held in the server cache.
UPSTREAM_CACHE_TTL_SECONDS=600

# --- CORS allowlist (comma separated origins) -----------------
# Empty falls back to localhost dev origins only.
CORS_ORIGINS=
